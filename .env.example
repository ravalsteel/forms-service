# Copy to .env (do not commit).

# --- Local (development) ---
SPRING_PROFILES_ACTIVE=development
SERVER_PORT=8094
MANAGEMENT_SERVER_PORT=8095
DATABASE_URL=jdbc:postgresql://localhost:5435/forms
DATABASE_USERNAME=forms
DATABASE_PASSWORD=forms
POSTGRES_PASSWORD=forms
# Optional: publish Postgres for DbGate on the LAN (compose defaults: 0.0.0.0:5435).
# POSTGRES_PUBLISH_BIND=0.0.0.0
# POSTGRES_PUBLISH_PORT=5435

# Shared cache — Projects/cache-service
# Host process: localhost | Docker app: host.docker.internal
REDIS_URL=redis://localhost:6379

# Shared broker — Projects/broker-service
AMQP_URL=amqp://raval:raval@localhost:5672

# IAM (Projects/identity/iam-service)
IAM_ISSUER=https://service-iam.localhost
IAM_JWKS_URI=http://localhost:8080/.well-known/jwks.json
IAM_BASE_URL=http://localhost:8080
FORMS_AUDIENCE=forms-api
FORMS_APPLICATION_CODE=forms
# Optional machine token for outbound IAM reconcile (users/memberships read)
IAM_SERVICE_BEARER_TOKEN=

CORS_ALLOWED_ORIGINS=

# File storage: local (default) or r2
# FILE_STORAGE_PROVIDER=local
# FILE_STORAGE_ROOT=./data/forms-files
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_KEY_PREFIX=forms/

# Observability — Projects/observability-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_TRACES_EXPORT_ENABLED=true
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_TRACES_SAMPLER=parent-based-always-on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_JAVA_EXPORTER_OTLP_RETRY_DISABLED=true

# --- Production (fill on host) ---
# Set ROOT_DOMAIN in this project's .env. Compose derives:
#   IAM_ISSUER / IAM_BASE_URL / IAM_JWKS_URI from https://service-iam.${ROOT_DOMAIN}
#   REDIS_URL from redis.${ROOT_DOMAIN}
#   AMQP_URL from rabbit.${ROOT_DOMAIN}
#   OTEL from https://otel.${ROOT_DOMAIN}
#   CORS from https://forms.${FRONTEND_ROOT_DOMAIN:-ravalgroups.com}
# Override a derived var only if that hostname truly differs.
#
# Postgres backups (optional R2 bucket):
#   mkdir -p secrets/backup && age-keygen -o secrets/backup/age.key
#   AGE_RECIPIENT=                 # age1… public key
#   BACKUP_R2_ACCOUNT_ID=
#   BACKUP_R2_ACCESS_KEY_ID=
#   BACKUP_R2_SECRET_ACCESS_KEY=
#   BACKUP_R2_BUCKET=
#   BACKUP_R2_ENDPOINT=
#
# ROOT_DOMAIN=
# SPRING_PROFILES_ACTIVE=production
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# RABBITMQ_DEFAULT_PASS=
# NOTIFICATION_EMAIL_PROVIDER=smtp
# NOTIFICATION_EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# OTEL_TRACES_SAMPLER=parent-based-trace-id-ratio
# OTEL_TRACES_SAMPLER_ARG=0.2
